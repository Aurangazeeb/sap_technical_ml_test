# Environment Configuration
# Copy this file to .env and adjust values for your environment.
# All variables use the SAP_ prefix and are loaded by pydantic-settings.

# ── Data ──────────────────────────────────────────────────────────────────────
SAP_DATA_PATH=data/marketing_sample_for_amazon_com-amazon_fashion_products__20200201_20200430__30k_data.ldjson

# ── Preprocessing thresholds ─────────────────────────────────────────────────
SAP_WEIGHT_SENTINEL=999999999
SAP_COL_DROP_THRESHOLD=0.60   # Drop columns with > 60% missing values
SAP_ROW_DROP_THRESHOLD=0.50   # Drop rows with > 50% missing values

# ── Models ───────────────────────────────────────────────────────────────────
SAP_TEXT_MODEL=all-MiniLM-L6-v2
SAP_IMAGE_MODEL=efficientnet_b0

# ── Embedding dimensions ─────────────────────────────────────────────────────
SAP_TEXT_EMBEDDING_DIM=384
SAP_IMAGE_EMBEDDING_DIM=1280

# ── Similarity weights (must sum to 1.0) ─────────────────────────────────────
SAP_WEIGHT_TEXT=0.4
SAP_WEIGHT_IMAGE=0.3
SAP_WEIGHT_STRUCTURED=0.3

# ── Fallback weights when image is unavailable (must sum to 1.0) ─────────────
SAP_FALLBACK_WEIGHT_TEXT=0.6
SAP_FALLBACK_WEIGHT_STRUCTURED=0.4

# ── Image cache ───────────────────────────────────────────────────────────────
SAP_IMAGE_CACHE_DIR=.cache/images
SAP_IMAGE_CACHE_SIZE=10000

# ── Feature extraction ───────────────────────────────────────────────────────
# Skip image download/extraction for fast startup (uses text + structured only).
# Set to false to enable image features (requires downloading 30k product images).
SAP_SKIP_IMAGES=true

# ── API ───────────────────────────────────────────────────────────────────────
SAP_API_HOST=0.0.0.0
SAP_API_PORT=8000
